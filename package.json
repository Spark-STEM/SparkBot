{
  "name": "sparkbot",
  "version": "0.1.0",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "generate": "node scripts/generate-registry.mjs",
    "generate:bun": "bun scripts/generate-registry.mjs",
    "dev": "npm run generate && node --env-file-if-exists=.env scripts/dev-local.mjs",
    "dev:bun": "bun run generate:bun && bun run scripts/dev-local.mjs",
    "deploy": "npm run generate && wrangler deploy",
    "deploy:bun": "bun run generate:bun && bunx wrangler deploy",
    "test": "node --test",
    "test:bun": "bun test",
    "typecheck": "tsc --noEmit",
    "audit:discordbs": "tsx scripts/audit-discordbs-api.ts",
    "audit:discordbs:bun": "bun run scripts/audit-discordbs-api.ts",
    "db:refresh-local": "node --env-file-if-exists=.env scripts/refresh-local-d1.mjs",
    "db:refresh-local:bun": "bun run scripts/refresh-local-d1.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/bun": "latest",
    "tsx": "^4.23.15",
    "wrangler": "^4.151.3"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "discord-api-types": "^0.38.57",
    "discord-interactions": "^4.4.0"
  }
}
